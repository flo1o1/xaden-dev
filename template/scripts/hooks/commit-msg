#!/usr/bin/env bash
# Git commit-msg hook: enforce Conventional Commits (drives SemVer decisions)
# and verify that cited requirement/rule IDs exist (guards against invented IDs).
# Merge, Revert, fixup! and squash! messages skip only the format check; their references
# are still verified (REQ-022). fixup!/squash! commits are validated again after squashing.
set -euo pipefail

# shellcheck source=SCRIPTDIR/../lib.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/lib.sh"

first_line="$(head -n 1 "$1")"
pattern='^(feat|fix|refactor|docs|test|chore|perf|build|ci|style|revert)(\([a-z0-9._-]+\))?!?: .{1,72}$'

check_format=1
case "$first_line" in
  Merge\ * | Revert\ \"* | fixup!\ * | squash!\ *) check_format=0 ;;
esac

if [ "$check_format" = "1" ] && ! printf '%s' "$first_line" | grep -Eq "$pattern"; then
  die "commit message must follow Conventional Commits:
  <type>(<scope>)!: <summary up to 72 chars>
  types: feat fix refactor docs test chore perf build ci style revert
  rule: docs/rules/git.md (in an adopted project: xaden doc rules-git)"
fi

# Cited REQ-/CC- IDs must exist; feat/fix must reference a requirement.
"$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)/scripts/verify-refs.sh" "$1"
